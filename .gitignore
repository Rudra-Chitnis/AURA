# ─────────────────────────────────────────────────────────────────────────────
# AURA — .gitignore
# Electron desktop app + Node.js backend + Python voice pipeline
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets & environment ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Runtime auth tokens ───────────────────────────────────────────────────────
# Electron saves the JWT token to %APPDATA%\AURA\ (outside repo).
# Legacy terminal mode saved to ~/.aura_token — also excluded.
.aura_token

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
release/
desktop/dist/
desktop/release/
desktop/build/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.venv/
ENV/

# Packaging artifacts
*.egg
*.egg-info/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
MANIFEST

# ── Audio / TTS runtime files ─────────────────────────────────────────────────
# Temporary audio files created during TTS playback (voice.py uses tempfile)
*.wav
*.mp3
*.ogg
*.flac
*.aac
*.m4a
*.tmp.mp3

# ── ML model weights & caches ────────────────────────────────────────────────
# faster-whisper downloads model weights to ~/.cache/huggingface/ (outside repo)
# @xenova/transformers downloads to backend/node_modules (covered by node_modules/)
# These patterns catch any accidental local model storage
whisper_models/
models/
!backend/models/
!backend/models/*.js
*.bin
*.pt
*.onnx
*.ot
.cache/
huggingface/
transformers_cache/

# ── Runtime persistence (Electron manages these in %APPDATA%\AURA\) ──────────
# These files live outside the repo by design (app.getPath('userData')).
# Listed here in case someone accidentally copies them into the project.
timers.json
reminders.json
aura-logs/
*.log
logs/
log.txt

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── OS generated ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Dev / admin scripts ───────────────────────────────────────────────────────
seed.js
resetpass.js

# ── Windows shortcuts (generated by create-shortcut.bat) ─────────────────────
*.lnk
AURA.lnk

# ── Screenshots (may contain personal info) ───────────────────────────────────
screenshots/

# ── Temporary & runtime ───────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig

# ── Miscellaneous ─────────────────────────────────────────────────────────────
memory.md
