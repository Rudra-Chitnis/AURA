# ─────────────────────────────────────────────────────────────────────────────
# AURA Backend — Environment Variables
#
# Copy this file to .env and fill in your values.
#   cp .env.example .env          (macOS/Linux)
#   copy .env.example .env        (Windows)
#
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local MongoDB instance (no auth). Start with: mongod --dbpath <your-data-dir>
# For MongoDB Atlas, use the connection string from your Atlas dashboard.
MONGO_URI=mongodb://localhost:27017/aura

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# REQUIRED: Replace with a long random secret before running.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# WARNING: Using "your_jwt_secret_here" in production is insecure.
# All user sessions will be invalidated if this value changes.
JWT_SECRET=your_jwt_secret_here

# ── Ollama — Local LLM Runtime ────────────────────────────────────────────────
# Ollama must be running: https://ollama.com
# Install models with: ollama pull mistral && ollama pull tinyllama
#
# OLLAMA_MODEL      — used for memory-heavy / personal / mixed queries (Mistral 7B ~4GB)
# OLLAMA_MODEL_FAST — used for general / action / lightweight queries (TinyLlama ~600MB)
#
# On low-RAM machines (< 8GB VRAM/RAM), set both to tinyllama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_MODEL_FAST=tinyllama
